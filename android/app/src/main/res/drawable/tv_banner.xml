<?xml version="1.0" encoding="utf-8"?>
<!-- 320×180 Android TV launcher banner: the app icon on the app's dark background. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient android:angle="0" android:startColor="#FF2E1A5C" android:endColor="#FF0A0A0F" />
            <size android:width="320dp" android:height="180dp" />
        </shape>
    </item>
    <item android:drawable="@mipmap/ic_launcher" android:gravity="center" android:width="112dp" android:height="112dp" />
</layer-list>
