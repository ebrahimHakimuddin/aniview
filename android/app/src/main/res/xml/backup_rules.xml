<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older: Auto Backup would copy the AniList sign-in and the paired TVs' keys (all in the app's
     settings file) to the cloud, so that file stays out of it. -->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
</full-backup-content>
