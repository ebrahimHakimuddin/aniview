<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. The app's settings file holds the AniList sign-in and the paired TVs' keys, so it stays out of
     cloud backup; moving to a new phone over a cable or Wi-Fi still carries it (and so history and settings). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
        <exclude domain="file" path="extensions" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="extensions" />
    </device-transfer>
</data-extraction-rules>
